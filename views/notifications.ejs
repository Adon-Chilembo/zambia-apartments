<%- include('partials/header') %>
<div class="page-head">
  <div><h1>Notifications</h1><p class="muted">Everything that happened on your account, newest first.</p></div>
  <% if (unread) { %><form method="post" action="/notifications/read-all"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn sm secondary">Mark all read</button></form><% } %>
</div>
<div class="card" style="max-width:760px">
  <% if (!items.length) { %>
    <div class="empty">No notifications yet.</div>
  <% } else { %>
    <ul class="list note-list">
      <% items.forEach(n => { %>
        <li class="<%= n.read_at ? '' : 'unread' %>">
          <a href="/notifications/<%= n.id %>">
            <span class="dot" aria-hidden="true"></span>
            <span class="txt"><%= n.text %><span class="tiny"><%= h.date(n.created_at) %><%= n.read_at ? '' : ' · New' %></span></span>
          </a>
        </li>
      <% }) %>
    </ul>
  <% } %>
</div>
<%- include('partials/footer') %>
