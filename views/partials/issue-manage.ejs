<%# Expects: i (issue), back (redirect url) %>
<div class="li-row">
  <div>
    <b><%= i.title %></b>
    <div class="issue-meta">
      <span class="badge plain <%= i.kind === 'problem' ? '' : 'blue' %>"><%= i.kind === 'problem' ? 'Problem' : 'Suggestion' %></span>
      <span class="badge plain"><%= i.category %></span>
      <% if (i.urgency === 'urgent') { %><span class="badge red">Urgent</span><% } %>
      <span class="tiny"><%= locals.showWhere ? (i.tenant_name + ' · ' + i.apartment_title + ' · ') : (i.tenant_name ? i.tenant_name + ' · ' : '') %><%= h.date(i.created_at) %></span>
    </div>
  </div>
  <%- include('status', { s: i.status }) %>
</div>
<% if (i.description) { %><p class="small muted" style="margin:0"><%= i.description %></p><% } %>
<% if (i.landlord_response) { %><div class="response"><b>Your reply:</b> <%= i.landlord_response %></div><% } %>
<details class="manage">
  <summary>Update / reply</summary>
  <form method="post" action="/landlord/issues/<%= i.id %>">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <input type="hidden" name="back" value="<%= back %>">
    <div class="row">
      <div class="field"><label>Status</label>
        <select name="status">
          <% ['open','in_progress','resolved'].forEach(s => { %><option value="<%= s %>" <%= i.status === s ? 'selected' : '' %>><%= h.STATUS_LABEL[s] %></option><% }) %>
        </select>
      </div>
    </div>
    <div class="field"><label>Reply to tenant</label><textarea name="landlord_response" placeholder="e.g. Plumber is coming on Thursday morning."><%= i.landlord_response || '' %></textarea></div>
    <button class="btn sm">Save</button>
  </form>
</details>
