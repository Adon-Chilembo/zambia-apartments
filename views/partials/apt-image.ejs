<%# Listing image: cover photo, else the drawn placeholder. Expects: apt; optional showStatus, showPrice %>
<div class="apt-img">
  <% if (apt.cover) { %>
    <img src="/uploads/<%= apt.cover %>" alt="<%= apt.title %>" loading="lazy">
  <% } else if (apt.image_url) { %>
    <img src="<%= apt.image_url %>" alt="<%= apt.title %>" loading="lazy">
  <% } else { %>
    <div class="ph"><%- include('apt-illustration', { apt }) %></div>
  <% } %>
  <% if (locals.showStatus) { %>
    <span class="badge badge-on <%= apt.status === 'available' ? 'green' : 'gold' %>"><%= h.STATUS_LABEL[apt.status] %></span>
  <% } %>
  <% if (locals.showPrice) { %>
    <span class="price-tag"><%= h.money(apt.rent_amount) %> <small>/ month</small></span>
  <% } %>
  <% if (apt.photo_count > 1) { %>
    <span class="photo-count">📷 <%= apt.photo_count %></span>
  <% } %>
</div>
