<!doctype html>
<html lang="en" data-theme="light">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · Tour Masters Apartments</title>
  <meta name="description" content="Find apartments across Zambia, stay connected with your landlord pay rent with Mobile Money or your bank, and find trusted maintenance workers.">
  <script>
    // Apply the saved theme before the page paints (default: light).
    try { var t = localStorage.getItem('theme'); if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t; } catch (e) {}
  </script>
  <link rel="icon" type="image/svg+xml" href="/static/logo.svg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/static/style.css">
</head>
<body class="<%= user && user.role === 'landlord' ? 'many-links' : '' %>">
<!-- Startup animation: shown once per visit (browser tab session), skipped for reduced-motion users -->
<div class="splash" id="splash" aria-hidden="true">
  <div class="splash-inner">
    <%- include('logo-mark') %>
    <div class="splash-word"><b>Tour Masters</b><em>Apartments</em></div>
    <i class="splash-bar"></i>
  </div>
</div>
<script>
  (function () {
    var s = document.getElementById('splash'), seen = false, finished = false;
    try { seen = sessionStorage.getItem('splashSeen') === '1'; } catch (e) {}
    if (seen || matchMedia('(prefers-reduced-motion: reduce)').matches) { s.remove(); return; }
    try { sessionStorage.setItem('splashSeen', '1'); } catch (e) {}
    var root = document.documentElement, start = Date.now();
    root.classList.add('splashing');
    function done() {
      if (finished) return; finished = true;
      // Let the animation play through (about 1.8s) even when the page loads instantly.
      setTimeout(function () {
        s.classList.add('out'); root.classList.remove('splashing');
        setTimeout(function () { s.remove(); }, 700);
      }, Math.max(0, 1800 - (Date.now() - start)));
    }
    if (document.readyState === 'complete') done(); else addEventListener('load', done);
    setTimeout(done, 4000); // never block the page longer than this on a slow connection
  })();
</script>
<div class="kente"></div>
<header class="topbar" id="topbar">
  <div class="wrap">
    <button class="nav-toggle" type="button" aria-label="Menu" aria-expanded="false" aria-controls="site-nav" onclick="var t=document.getElementById('topbar');var o=t.classList.toggle('open');this.setAttribute('aria-expanded',o)">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
    </button>
    <a class="logo" href="/">
      <%- include('logo-mark') %>
      <span class="wordmark"><b>Tour Masters</b><em>Apartments</em></span>
    </a>
    <nav class="nav" id="site-nav">
      <a href="/" class="<%= path === '/' ? 'active' : '' %>">Apartments</a>
      <a href="/workers" class="<%= path.startsWith('/workers') ? 'active' : '' %>">Maintenance workers</a>
      <% if (user && user.role === 'tenant') { %>
        <a href="/tenant" class="<%= path.startsWith('/tenant') || path.startsWith('/pay') ? 'active' : '' %>">My home</a>
      <% } else if (user && user.role === 'worker') { %>
        <a href="/worker" class="<%= path.startsWith('/worker') && !path.startsWith('/workers') ? 'active' : '' %>">My services</a>
      <% } else if (user && user.role === 'landlord') { %>
        <a href="/landlord" class="<%= locals.section === 'dashboard' ? 'active' : '' %>">Dashboard</a>
        <a href="/landlord/tenants" class="<%= locals.section === 'tenants' ? 'active' : '' %>">Tenants</a>
        <a href="/landlord/issues" class="<%= locals.section === 'issues' ? 'active' : '' %>">Issues</a>
        <a href="/landlord/payments" class="<%= locals.section === 'payments' ? 'active' : '' %>">Payments</a>
      <% } %>
      <% if (user) { %>
        <a href="/account" class="<%= path.startsWith('/account') ? 'active' : '' %>">Account</a>
        <form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="linklike">Log out</button></form>
        <span class="whoami"><%= user.name %> · <%= user.role %></span>
      <% } else { %>
        <a href="/login" class="<%= path === '/login' ? 'active' : '' %>">Log in</a>
        <a class="btn sm" href="/register">Sign up</a>
      <% } %>
    </nav>
    <% if (user) { %>
      <details class="bell" id="bell">
        <summary aria-label="Notifications<%= unread ? ' (' + unread + ' unread)' : '' %>" title="Notifications">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 1 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg>
          <% if (unread) { %><span class="bell-count"><%= unread > 9 ? '9+' : unread %></span><% } %>
        </summary>
        <div class="bell-panel">
          <div class="bell-head">
            <b>Notifications</b>
            <% if (unread) { %><form method="post" action="/notifications/read-all"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="linklike small">Mark all read</button></form><% } %>
          </div>
          <% if (!recentNotes.length) { %>
            <p class="bell-empty">Nothing yet. We'll let you know when something happens.</p>
          <% } else { %>
            <ul>
              <% recentNotes.forEach(n => { %>
                <li class="<%= n.read_at ? '' : 'unread' %>"><a href="/notifications/<%= n.id %>"><span><%= n.text %></span><span class="tiny"><%= h.date(n.created_at) %></span></a></li>
              <% }) %>
            </ul>
          <% } %>
          <a class="bell-all" href="/notifications">See all notifications</a>
        </div>
      </details>
      <script>
        // Close the bell panel when clicking elsewhere.
        document.addEventListener('click', function (e) { var b = document.getElementById('bell'); if (b && b.open && !b.contains(e.target)) b.open = false; });
      </script>
    <% } %>
    <button class="theme-toggle" type="button" aria-label="Switch light or dark mode" title="Light / dark mode"
      onclick="var d=document.documentElement;var n=d.dataset.theme==='dark'?'light':'dark';d.dataset.theme=n;try{localStorage.setItem('theme',n)}catch(e){}">
      <svg class="stars" viewBox="0 0 24 24" fill="currentColor"><circle cx="4" cy="6" r="1.4"/><circle cx="12" cy="3" r="1"/><circle cx="9" cy="14" r="1.2"/></svg>
      <span class="knob"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg></span>
    </button>
  </div>
</header>
<script>
  // The header is see-through over the landing hero; give it a solid background once the page scrolls.
  (function () { var t = document.getElementById('topbar'); function s() { t.classList.toggle('scrolled', window.scrollY > 24); } s(); addEventListener('scroll', s, { passive: true }); })();
</script>
<main class="<%= locals.bare ? 'bare' : '' %>">
<% if (locals.bare) { %>
  <% if (flash) { %><div class="wrap flash-wrap"><div class="flash <%= flash.type %>" style="margin:0"><%= flash.text %></div></div><% } %>
<% } else { %>
<div class="wrap">
<% if (flash) { %><div class="flash <%= flash.type %>"><%= flash.text %></div><% } %>
<% } %>
