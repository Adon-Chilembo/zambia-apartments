<%- include('../partials/header') %>
<div class="page-head">
  <div><h1>Payments</h1><p class="muted">All rent payments from your tenants.</p></div>
  <div class="card stat" style="padding:10px 16px"><div class="label">Total received</div><div class="value" style="font-size:1.3rem"><%= h.money(total) %></div></div>
</div>
<div class="card">
  <% if (!payments.length) { %><div class="empty">No payments yet.</div><% } else { %>
    <div class="table-wrap"><table>
      <thead><tr><th>Date</th><th>Tenant</th><th>Apartment</th><th>Month</th><th>Method</th><th>Reference</th><th class="num">Amount</th><th>Status</th></tr></thead>
      <tbody>
        <% payments.forEach(p => { %>
          <tr>
            <td><%= h.date(p.paid_at || p.created_at) %></td>
            <td><b><%= p.tenant_name %></b></td>
            <td><a href="/landlord/apartments/<%= p.apartment_id %>?tab=payments"><%= p.apartment_title %></a></td>
            <td><%= h.period(p.period) %></td>
            <td><%= h.payMethod(p) %><div class="tiny"><%= h.payFrom(p) %></div></td>
            <td class="tiny"><%= p.reference %></td>
            <td class="num"><%= h.money(p.amount) %></td>
            <td><%- include('../partials/status', { s: p.status }) %></td>
          </tr>
        <% }) %>
      </tbody>
    </table></div>
  <% } %>
</div>
<%- include('../partials/footer') %>
