<%- include('../partials/header') %>
<% const a = apartment; const openIssues = issues.filter(i => i.status !== 'resolved').length; const base = '/landlord/apartments/' + a.id; %>

<p class="small"><a href="/landlord">← Dashboard</a></p>
<section class="house-head">
  <div class="bgimg">
    <% if (photos[0]) { %><img src="/uploads/<%= photos[0].filename %>" alt="<%= photos[0].caption || a.title %>">
    <% } else { %><%- include('../partials/apt-illustration', { apt: a, idSuffix: 'head' }) %><% } %>
  </div>
  <div class="inner">
    <div>
      <span class="badge <%= a.status === 'occupied' ? 'gold' : 'green' %>"><%= a.status === 'occupied' ? 'Rented' + (tenant ? ' to ' + tenant.name : '') : 'Available' %></span>
      <h1><%= a.title %></h1>
      <div class="area">📍 <%= a.neighbourhood %>, <%= a.city %><%= a.address ? ' · ' + a.address : '' %></div>
      <div class="tiny" style="color:rgba(255,255,255,.8);margin-top:4px"><%= a.bedrooms %> bed · <%= a.bathrooms %> bath · <%= h.money(a.rent_amount) %>/month</div>
    </div>
    <div style="display:flex;gap:8px;flex-wrap:wrap">
      <% if (!photos.length) { %><a class="btn sm gold" href="<%= base %>?tab=photos">Add a main photo</a><% } %>
      <a class="btn sm glass" href="/apartments/<%= a.id %>">View public listing</a>
    </div>
  </div>
</section>

<nav class="tabs">
  <a href="<%= base %>" class="<%= tab === 'tenant' ? 'active' : '' %>">Tenant</a>
  <a href="<%= base %>?tab=issues" class="<%= tab === 'issues' ? 'active' : '' %>">Problems &amp; suggestions <span class="count"><%= openIssues %></span></a>
  <a href="<%= base %>?tab=payments" class="<%= tab === 'payments' ? 'active' : '' %>">Payments <span class="count"><%= payments.length %></span></a>
  <a href="<%= base %>?tab=photos" class="<%= tab === 'photos' ? 'active' : '' %>">Photos <span class="count"><%= photos.length %></span></a>
  <a href="<%= base %>?tab=edit" class="<%= tab === 'edit' ? 'active' : '' %>">Edit listing &amp; services</a>
</nav>

<% if (tab === 'tenant') { %>
  <% if (tenant) { %>
    <div class="grid-2">
      <div class="card pad">
        <div class="li-row">
          <div class="person">
            <div class="avatar lg"><%= h.initials(tenant.name) %></div>
            <div><h2 style="margin:0"><%= tenant.name %></h2><div class="small muted">Tenant since <%= h.date(tenant.start_date) %></div></div>
          </div>
          <% if (paidThisMonth) { %><span class="badge green">Rent paid this month</span><% } else { %><span class="badge red">Rent not paid this month</span><% } %>
        </div>
        <dl class="details" style="margin-top:18px">
          <dt>Phone</dt><dd><% if (tenant.phone) { %><a href="tel:<%= tenant.phone %>"><%= tenant.phone %></a><% } else { %>—<% } %></dd>
          <dt>Email</dt><dd><a href="mailto:<%= tenant.email %>"><%= tenant.email %></a></dd>
          <dt>Household</dt><dd><% if (tenant.occupants) { %><b><%= h.people(tenant.occupants) %></b><% if (tenant.household_note) { %><div class="tiny"><%= tenant.household_note %></div><% } %><% } else { %><span class="muted">Not given yet</span><% } %></dd>
          <dt>Occupation</dt><dd><%= tenant.occupation || '—' %></dd>
          <dt>Emergency contact</dt><dd><%= tenant.emergency_contact || '—' %></dd>
          <dt>Open issues</dt><dd><a href="<%= base %>?tab=issues"><%= openIssues %></a></dd>
          <dt>Total paid</dt><dd><%= h.money(payments.filter(p => p.tenant_id === tenant.id && p.status === 'success').reduce((s, p) => s + p.amount, 0)) %></dd>
        </dl>
      </div>
      <div class="card pad">
        <h3>End tenancy</h3>
        <p class="small muted">When the tenant moves out, end the tenancy. The apartment goes back on the public listings, and the history stays here.</p>
        <form method="post" action="/landlord/tenancies/<%= tenant.tenancy_id %>/end" onsubmit="return confirm('End the tenancy for <%= tenant.name.replace(/'/g, '') %>? The apartment will be listed as available again.')">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <button class="btn danger">End tenancy</button>
        </form>
      </div>
    </div>
  <% } else { %>
    <div class="grid-2">
      <div class="card">
        <div class="card-head"><h2>Applications</h2></div>
        <% if (!applications.length) { %><div class="empty">No one has applied yet. The apartment is visible on the public listings.</div><% } else { %>
          <ul class="list">
            <% applications.forEach(ap => { %>
              <li>
                <div class="li-row">
                  <div class="person"><div class="avatar"><%= h.initials(ap.name) %></div>
                    <div><b><%= ap.name %></b><div class="tiny"><%= ap.email %><%= ap.phone ? ' · ' + ap.phone : '' %><%= ap.occupation ? ' · ' + ap.occupation : '' %></div><div class="small" style="margin-top:2px">👥 <b><%= h.people(ap.occupants) %></b><%= ap.household_note ? ' · ' + ap.household_note : '' %></div></div>
                  </div>
                  <div style="display:flex;gap:6px">
                    <form class="inline-form" method="post" action="/landlord/applications/<%= ap.id %>/approve"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="back" value="apartment"><button class="btn sm">Approve</button></form>
                    <form class="inline-form" method="post" action="/landlord/applications/<%= ap.id %>/reject"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="back" value="apartment"><button class="btn sm secondary">Decline</button></form>
                  </div>
                </div>
                <% if (ap.message) { %><div class="response">“<%= ap.message %>”</div><% } %>
              </li>
            <% }) %>
          </ul>
        <% } %>
      </div>
      <div class="card pad">
        <h2>Invite a tenant</h2>
        <p class="small muted">Already have someone moving in? Create a code and give it to them. They enter it after signing up and are connected straight away.</p>
        <form method="post" action="<%= base %>/invites">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <div class="row">
            <div class="field"><label for="tenant_name">Tenant name <span class="tiny">(optional)</span></label><input type="text" id="tenant_name" name="tenant_name"></div>
            <div class="field"><label for="tenant_email">Email <span class="tiny">(optional)</span></label><input type="email" id="tenant_email" name="tenant_email"></div>
          </div>
          <button class="btn">Create invite code</button>
        </form>
        <% const openInvites = invites.filter(i => !i.used_by); if (openInvites.length) { %>
          <h3 style="margin-top:20px">Active codes</h3>
          <ul class="list" style="margin:0 -20px">
            <% openInvites.forEach(i => { %>
              <li class="li-row">
                <div><span class="code"><%= i.code %></span><div class="tiny" style="margin-top:4px"><%= i.tenant_name || 'Anyone with the code' %> · <%= h.date(i.created_at) %></div></div>
                <form class="inline-form" method="post" action="/landlord/invites/<%= i.id %>/delete"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn sm secondary">Cancel</button></form>
              </li>
            <% }) %>
          </ul>
        <% } %>
      </div>
    </div>
  <% } %>
  <div class="card map-card" style="margin-top:18px">
    <div class="card-head">
      <div>
        <h3>Where it is</h3>
        <div class="tiny">📍 <%= h.mapQuery(a) %></div>
      </div>
      <a class="btn sm secondary" href="<%= h.mapLink(a) %>" target="_blank" rel="noopener">Open in Google Maps</a>
    </div>
    <iframe src="<%= h.mapEmbedUrl(a) %>" title="Map of <%= a.neighbourhood %>, <%= a.city %>" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
    <% if (!a.address) { %><div class="card-body tiny">Showing the neighbourhood. <a href="<%= base %>?tab=edit">Add the street address</a> to pin the exact house.</div><% } %>
  </div>

  <% if (pastTenants.length) { %>
    <div class="card" style="margin-top:18px">
      <div class="card-head"><h3>Past tenants</h3></div>
      <ul class="list"><% pastTenants.forEach(p => { %><li class="small"><b><%= p.name %></b> · <%= h.date(p.start_date) %> – <%= h.date(p.end_date) %></li><% }) %></ul>
    </div>
  <% } %>
<% } %>

<% if (tab === 'issues') { %>
  <div class="card">
    <% if (!issues.length) { %><div class="empty">No problems or suggestions reported for this apartment.</div><% } else { %>
      <ul class="list">
        <% issues.forEach(i => { %><li><%- include('../partials/issue-manage', { i, back: base + '?tab=issues' }) %></li><% }) %>
      </ul>
    <% } %>
  </div>
<% } %>

<% if (tab === 'payments') { %>
  <div class="card">
    <% if (!payments.length) { %><div class="empty">No payments for this apartment yet.</div><% } else { %>
      <div class="table-wrap"><table>
        <thead><tr><th>Date</th><th>Tenant</th><th>Month</th><th>Method</th><th>Reference</th><th class="num">Amount</th><th>Status</th></tr></thead>
        <tbody>
          <% payments.forEach(p => { %>
            <tr>
              <td><%= h.date(p.paid_at || p.created_at) %></td>
              <td><%= p.tenant_name %></td>
              <td><b><%= h.period(p.period) %></b></td>
              <td><%= h.NETWORKS[p.network] || 'Mobile Money' %><div class="tiny"><%= p.phone %></div></td>
              <td class="tiny"><%= p.reference %></td>
              <td class="num"><%= h.money(p.amount) %></td>
              <td><%- include('../partials/status', { s: p.status }) %></td>
            </tr>
          <% }) %>
        </tbody>
      </table></div>
    <% } %>
  </div>
<% } %>

<% if (tab === 'photos') { %>
  <div class="card pad" style="margin-bottom:18px">
    <h2>Add photos</h2>
    <p class="muted small" style="margin-bottom:14px">Show tenants the rooms and the area: bedrooms, kitchen, bathroom, the yard, parking, the view. The first photo is the cover on the listings. JPG, PNG or WebP, up to <%= uploadLimits.MAX_FILE_MB %> MB each, <%= uploadLimits.MAX_FILES_PER_UPLOAD %> at a time.</p>
    <form method="post" action="<%= base %>/photos?_csrf=<%= csrf %>" enctype="multipart/form-data" class="dropzone">
      <div class="row">
        <div class="field"><label for="photos">Photos</label><input type="file" id="photos" name="photos" accept="image/jpeg,image/png,image/webp" multiple required></div>
        <div class="field"><label for="caption">Caption <span class="tiny">(optional, for this batch)</span></label><input type="text" id="caption" name="caption" maxlength="120" placeholder="e.g. Main bedroom, Kitchen, Garden"></div>
      </div>
      <button class="btn">Upload photos</button>
    </form>
  </div>

  <% if (!photos.length) { %>
    <div class="card empty">No photos yet. Listings with photos get far more interest.</div>
  <% } else { %>
    <div class="photo-grid">
      <% photos.forEach((p, i) => { %>
        <div class="card photo-item">
          <div class="thumb">
            <img src="/uploads/<%= p.filename %>" alt="<%= p.caption || 'Apartment photo' %>" loading="lazy">
            <% if (i === 0) { %><span class="badge solid plain">★ Cover photo</span><% } %>
          </div>
          <div class="pbody">
            <form class="cap-form" method="post" action="/landlord/photos/<%= p.id %>/caption">
              <input type="hidden" name="_csrf" value="<%= csrf %>">
              <input type="text" name="caption" value="<%= p.caption || '' %>" maxlength="120" placeholder="Add a caption" aria-label="Caption">
              <button class="btn sm secondary">Save</button>
            </form>
            <div class="pactions">
              <% if (i > 0) { %>
                <form class="inline-form" method="post" action="/landlord/photos/<%= p.id %>/cover"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn sm secondary">★ Make cover</button></form>
                <form class="inline-form" method="post" action="/landlord/photos/<%= p.id %>/move"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="direction" value="up"><button class="btn sm secondary" aria-label="Move earlier">←</button></form>
              <% } %>
              <% if (i < photos.length - 1) { %>
                <form class="inline-form" method="post" action="/landlord/photos/<%= p.id %>/move"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="direction" value="down"><button class="btn sm secondary" aria-label="Move later">→</button></form>
              <% } %>
              <form class="inline-form" method="post" action="/landlord/photos/<%= p.id %>/delete" onsubmit="return confirm('Remove this photo?')"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn sm danger">Remove</button></form>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
<% } %>

<% if (tab === 'edit') { %>
  <div class="card pad" style="max-width:860px">
    <%- include('apartment-form', { apartment: a }) %>
  </div>
<% } %>

<%- include('../partials/footer') %>
