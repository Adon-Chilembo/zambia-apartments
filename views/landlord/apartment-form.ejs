<% const a = apartment; const editing = !!a.id; %>
<% if (!editing) { %><%- include('../partials/header') %>
<p class="small"><a href="/landlord">← Dashboard</a></p>
<div class="card pad" style="max-width:760px">
  <h1>Add an apartment</h1>
  <p class="muted">It will show on the public listings page right away.</p>
<% } %>
  <% if (locals.error) { %><div class="flash error"><%= error %></div><% } %>
  <form method="post" action="<%= editing ? '/landlord/apartments/' + a.id : '/landlord/apartments' %>">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="field"><label for="title">Title</label><input type="text" id="title" name="title" value="<%= a.title || '' %>" required placeholder="e.g. Bright 2-bedroom with balcony"></div>
    <div class="row">
      <div class="field"><label for="neighbourhood">Neighbourhood</label><input type="text" id="neighbourhood" name="neighbourhood" value="<%= a.neighbourhood || '' %>" required placeholder="Kabulonga"></div>
      <div class="field"><label for="city">City</label><input type="text" id="city" name="city" value="<%= a.city || '' %>" required placeholder="Lusaka" list="cities"></div>
    </div>
    <div class="field">
      <label for="address">Street address or directions <span class="tiny">(optional, private)</span></label>
      <input type="text" id="address" name="address" maxlength="200" value="<%= a.address || '' %>" placeholder="e.g. Plot 12, Lukasu Road, near Kabulonga Girls">
      <span class="tiny">Used for the map. Only you and the tenant living there see it; people browsing the listings only see the neighbourhood and city.</span>
    </div>
    <datalist id="cities"><% ['Lusaka','Kitwe','Ndola','Livingstone','Kabwe','Chingola','Solwezi','Chipata','Kasama','Mufulira'].forEach(c => { %><option value="<%= c %>"><% }) %></datalist>
    <div class="row">
      <div class="field"><label for="bedrooms">Bedrooms</label><input type="number" id="bedrooms" name="bedrooms" min="0" max="20" value="<%= a.bedrooms ?? 1 %>"></div>
      <div class="field"><label for="bathrooms">Bathrooms</label><input type="number" id="bathrooms" name="bathrooms" min="0" max="20" value="<%= a.bathrooms ?? 1 %>"></div>
      <div class="field"><label for="rent_amount">Monthly rent (K, ZMW)</label><input type="number" id="rent_amount" name="rent_amount" min="1" step="0.01" value="<%= a.rent_amount || '' %>" required></div>
    </div>
    <div class="field"><label for="description">Description</label><textarea id="description" name="description" rows="5"><%= a.description || '' %></textarea></div>
    <% const chosen = new Set((a.services || '').split(',')); %>
    <fieldset class="field" style="border:0;padding:0;margin:0 0 16px">
      <legend style="font-weight:700;font-size:.88rem;margin-bottom:4px">Services this apartment offers</legend>
      <p class="tiny" style="margin:0 0 10px">Tick everything that comes with the apartment. Tenants see these as icons on the listing.</p>
      <div class="svc-pick">
        <% svc.SERVICES.forEach(s => { %>
          <label class="svc-opt"><input type="checkbox" name="services" value="<%= s.key %>" <%= chosen.has(s.key) ? 'checked' : '' %>><%- svc.serviceIcon(s) %><span><%= s.label %></span></label>
        <% }) %>
      </div>
    </fieldset>
    <div class="field"><label for="amenities">Other features <span class="tiny">(optional, comma separated)</span></label><input type="text" id="amenities" name="amenities" value="<%= a.amenities || '' %>" placeholder="Swimming pool, Mango trees, Near UNZA"></div>
    <button class="btn lg"><%= editing ? 'Save changes' : 'List apartment and add photos' %></button>
  </form>
<% if (!editing) { %>
</div>
<%- include('../partials/footer') %>
<% } %>
