<%- include('../partials/header') %>

<div class="page-head">
  <div>
    <h1>Hello, <%= user.name.split(' ')[0] %></h1>
    <p class="muted">Here's what's happening across your apartments in <%= h.period(month) %>.</p>
  </div>
  <a class="btn" href="/landlord/apartments/new">+ Add apartment</a>
</div>

<div class="stat-row">
  <div class="card stat">
    <div class="label">Apartments</div>
    <div class="value"><%= stats.units %></div>
    <div class="sub"><%= stats.occupied %> occupied · <%= stats.units - stats.occupied %> available</div>
  </div>
  <div class="card stat">
    <div class="label">Rent collected · <%= h.period(month) %></div>
    <div class="value"><%= h.money(stats.collected) %></div>
    <div class="sub">of <%= h.money(stats.expected) %> expected</div>
    <div class="meter"><i style="width:<%= stats.expected ? Math.min(100, Math.round(stats.collected / stats.expected * 100)) : 0 %>%"></i></div>
  </div>
  <div class="card stat">
    <div class="label">Tenants not yet paid</div>
    <div class="value" style="color:<%= stats.unpaid ? 'var(--red)' : 'inherit' %>"><%= stats.unpaid %></div>
    <div class="sub">for <%= h.period(month) %></div>
  </div>
  <div class="card stat">
    <div class="label">Open issues</div>
    <div class="value"><%= stats.openIssues %></div>
    <div class="sub"><a href="/landlord/issues">View all</a></div>
  </div>
</div>

<% if (applications.length) { %>
  <div class="card" style="margin-bottom:18px">
    <div class="card-head"><h2>Applications waiting for you</h2><span class="badge gold"><%= applications.length %> pending</span></div>
    <ul class="list">
      <% applications.forEach(a => { %>
        <li class="li-row">
          <div class="person">
            <div class="avatar"><%= h.initials(a.name) %></div>
            <div>
              <b><%= a.name %></b> <span class="small muted">applied for <a href="/landlord/apartments/<%= a.apartment_id %>"><%= a.title %></a></span>
              <div class="tiny"><%= a.email %><%= a.phone ? ' · ' + a.phone : '' %><%= a.occupation ? ' · ' + a.occupation : '' %> · <%= h.date(a.created_at) %></div>
              <div class="small" style="margin-top:2px">👥 <b><%= h.people(a.occupants) %></b><%= a.household_note ? ' · ' + a.household_note : '' %></div>
              <% if (a.message) { %><div class="response">“<%= a.message %>”</div><% } %>
            </div>
          </div>
          <div style="display:flex;gap:6px">
            <form class="inline-form" method="post" action="/landlord/applications/<%= a.id %>/approve"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn sm">Approve</button></form>
            <form class="inline-form" method="post" action="/landlord/applications/<%= a.id %>/reject"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn sm secondary">Decline</button></form>
          </div>
        </li>
      <% }) %>
    </ul>
  </div>
<% } %>

<% const rented = apartments.filter(a => a.status === 'occupied'); const vacant = apartments.filter(a => a.status !== 'occupied'); %>
<section style="margin-bottom:26px">
  <div class="page-head" style="margin-bottom:14px">
    <div>
      <span class="eyebrow">Your houses</span>
      <h2 style="margin:0">Rented <span class="muted" style="font-weight:600">(<%= rented.length %>)</span> · Available <span class="muted" style="font-weight:600">(<%= vacant.length %>)</span></h2>
    </div>
  </div>
  <% if (!apartments.length) { %>
    <div class="card empty">You haven't listed any apartments yet. <a href="/landlord/apartments/new">Add your first one</a>.</div>
  <% } else { %>
    <div class="listing-grid">
      <% apartments.forEach(a => { %>
        <a class="card listing house-card" href="/landlord/apartments/<%= a.id %>">
          <div class="apt-img">
            <% if (a.cover) { %><img src="/uploads/<%= a.cover %>" alt="<%= a.title %>" loading="lazy">
            <% } else { %><div class="ph"><%- include('../partials/apt-illustration', { apt: a, idSuffix: 'dash' }) %></div><% } %>
            <span class="badge badge-on <%= a.status === 'occupied' ? 'gold' : 'green' %>"><%= a.status === 'occupied' ? 'Rented' : 'Available' %></span>
            <span class="price-tag"><%= h.money(a.rent_amount) %> <small>/ month</small></span>
            <% if (!a.photo_count) { %><span class="photo-count">No photos yet</span><% } else if (a.photo_count > 1) { %><span class="photo-count">📷 <%= a.photo_count %></span><% } %>
          </div>
          <div class="body">
            <div class="title"><%= a.title %></div>
            <div class="area">📍 <b><%= a.neighbourhood %></b>, <%= a.city %></div>
            <% if (a.address) { %><div class="tiny"><%= a.address %></div><% } %>
            <% if (a.status === 'occupied') { %>
              <div class="house-tenant">
                <span class="avatar sm"><%= h.initials(a.tenant_name) %></span>
                <div>
                  <b><%= a.tenant_name %></b>
                  <div class="tiny">👥 <%= h.people(a.tenant_occupants) %> · since <%= h.date(a.tenant_since) %></div>
                </div>
              </div>
              <div class="issue-meta" style="margin:8px 0 0">
                <% if (a.paid_this_month) { %><span class="badge green">Rent paid · <%= h.period(month) %></span><% } else { %><span class="badge red">Rent not paid · <%= h.period(month) %></span><% } %>
                <% if (a.open_issues) { %><span class="badge red"><%= a.open_issues %> open issue<%= a.open_issues === 1 ? '' : 's' %></span><% } %>
              </div>
            <% } else { %>
              <div class="issue-meta" style="margin:8px 0 0">
                <span class="badge plain">No tenant yet</span>
                <% if (a.pending_apps) { %><span class="badge gold"><%= a.pending_apps %> applied</span><% } %>
              </div>
            <% } %>
          </div>
        </a>
      <% }) %>
    </div>
  <% } %>
</section>

<div class="grid-2">
  <div class="stack">
    <div class="card">
      <div class="card-head"><h2>Rent status · <%= h.period(month) %></h2><a class="small" href="/landlord/tenants">All tenants</a></div>
      <% if (!tenants.length) { %><div class="empty">No tenants yet.</div><% } else { %>
        <ul class="list">
          <% tenants.forEach(t => { %>
            <li class="li-row">
              <div class="person">
                <div class="avatar"><%= h.initials(t.name) %></div>
                <div><b><%= t.name %></b><div class="tiny"><%= t.title %> · <%= h.money(t.rent_amount) %>/month · 👥 <%= h.people(t.occupants) %></div></div>
              </div>
              <% if (t.paid_this_month) { %><span class="badge green">Paid</span><% } else { %><span class="badge red">Not paid</span><% } %>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </div>
  </div>

  <div class="stack">
    <div class="card">
      <div class="card-head"><h2>Needs attention</h2><a class="small" href="/landlord/issues">All issues</a></div>
      <% if (!issues.length) { %><div class="empty">No open problems or suggestions. 🎉</div><% } else { %>
        <ul class="list">
          <% issues.forEach(i => { %><li><%- include('../partials/issue-manage', { i, back: '/landlord', showWhere: true }) %></li><% }) %>
        </ul>
      <% } %>
    </div>
    <div class="card">
      <div class="card-head"><h2>Latest payments</h2><a class="small" href="/landlord/payments">All payments</a></div>
      <% if (!recentPayments.length) { %><div class="empty">No payments yet.</div><% } else { %>
        <ul class="list">
          <% recentPayments.forEach(p => { %>
            <li class="li-row">
              <div><b><%= p.tenant_name %></b><div class="tiny"><%= p.apartment_title %> · <%= h.period(p.period) %> · <%= h.date(p.paid_at || p.created_at) %></div></div>
              <div style="text-align:right"><b><%= h.money(p.amount) %></b><div><%- include('../partials/status', { s: p.status }) %></div></div>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
