<%- include('../partials/header') %>

<div class="page-head">
  <div>
    <h1>Welcome, <%= user.name.split(' ')[0] %></h1>
    <p class="muted">You're not connected to an apartment yet. There are two ways to connect.</p>
  </div>
</div>

<div class="grid-2 even">
  <div class="card pad">
    <h2>I have an invite code</h2>
    <p class="muted small">Already renting? Ask your landlord for the invite code for your apartment and enter it here.</p>
    <form method="post" action="/tenant/join">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div class="field"><label for="code">Invite code</label><input type="text" id="code" name="code" value="<%= code %>" placeholder="ABCD-1234" required style="text-transform:uppercase;letter-spacing:.06em"></div>
      <button class="btn">Connect to my apartment</button>
    </form>
  </div>
  <div class="card pad">
    <h2>I'm looking for a place</h2>
    <p class="muted small">Browse available apartments and apply. When the landlord approves, you're connected automatically.</p>
    <a class="btn secondary" href="/">Browse apartments</a>
  </div>
</div>

<div class="card" style="margin-top:18px">
  <div class="card-head"><h2>My applications</h2></div>
  <% if (!applications.length) { %>
    <div class="empty">You haven't applied for any apartments yet.</div>
  <% } else { %>
    <ul class="list">
      <% applications.forEach(a => { %>
        <li class="li-row">
          <div>
            <a href="/apartments/<%= a.apartment_id %>"><b><%= a.title %></b></a>
            <div class="small muted"><%= a.neighbourhood %>, <%= a.city %> · <%= h.money(a.rent_amount) %>/month · applied <%= h.date(a.created_at) %></div>
          </div>
          <div style="display:flex;gap:8px;align-items:center">
            <%- include('../partials/status', { s: a.status }) %>
            <% if (a.status === 'pending') { %>
              <form class="inline-form" method="post" action="/tenant/applications/<%= a.id %>/withdraw"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn sm secondary">Withdraw</button></form>
            <% } %>
          </div>
        </li>
      <% }) %>
    </ul>
  <% } %>
</div>

<%- include('../partials/footer') %>
