<%- include('../partials/header') %>
<div class="momo">
  <p class="tiny">Demo Mobile Money prompt. In live mode this appears on the tenant's phone.</p>
  <div class="phone-frame">
    <div class="small muted"><%= networkName %></div>
    <div style="font-weight:700;margin-top:10px">Approve payment to Tour Masters Apartments?</div>
    <div class="amt"><%= h.money(payment.amount) %></div>
    <div class="small muted">Rent for <%= h.period(payment.period) %> · <%= payment.title %></div>
    <div class="tiny" style="margin:6px 0 20px">From <%= payment.phone %> · Ref <%= payment.reference %></div>
    <form method="post" style="display:grid;gap:8px">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <button class="btn block" name="decision" value="approve">Approve</button>
      <button class="btn block danger" name="decision" value="decline">Decline</button>
    </form>
  </div>
</div>
<%- include('../partials/footer') %>
