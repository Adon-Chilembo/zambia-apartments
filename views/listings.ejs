<%- include('partials/header') %>

<% const ctaHref = !user ? '/register?role=landlord' : user.role === 'landlord' ? '/landlord/apartments/new' : '/tenant'; %>
<% const ctaText = !user ? 'List your property' : user.role === 'landlord' ? 'List a new apartment' : 'Go to my home'; %>

<!-- Hero -->
<%
  // Hero slideshow: the cover photo of up to six apartments, vacant ones first.
  const heroApts = apartments.filter(x => x.photos && x.photos.length)
    .sort((x, y) => (x.status === 'available' ? 0 : 1) - (y.status === 'available' ? 0 : 1))
    .slice(0, 6);
%>
<section class="hero-full" style="--hero: url('<%= heroApts.length ? h.photoSrc(heroApts[0].photos[0]) : heroImage %>')">
  <% if (heroApts.length) { %>
    <div class="hero-slides" aria-hidden="true">
      <% heroApts.forEach((x, i) => { %>
        <div class="hero-slide <%= i === 0 ? 'on' : '' %>" <% if (i === 0) { %>style="background-image:url('<%= h.photoSrc(x.photos[0]) %>')"<% } else { %>data-bg="<%= h.photoSrc(x.photos[0]) %>"<% } %>></div>
      <% }) %>
    </div>
    <a class="hero-caption" id="hero-caption" href="/apartments/<%= heroApts[0].id %>">
      <b><%= heroApts[0].title %></b>
      <span><%= heroApts[0].neighbourhood %>, <%= heroApts[0].city %> · <%= h.money(heroApts[0].rent_amount).replace('.00', '') %> / month</span>
    </a>
    <% if (heroApts.length > 1) { %>
      <div class="hero-dots" id="hero-dots">
        <% heroApts.forEach((x, i) => { %><button type="button" class="<%= i === 0 ? 'on' : '' %>" aria-label="Show <%= x.title %>"></button><% }) %>
      </div>
      <script>
        // Hero slideshow: fades between apartments every few seconds; the caption links to the one on screen.
        document.addEventListener('DOMContentLoaded', function () {
          var apts = <%- JSON.stringify(heroApts.map(x => ({ href: '/apartments/' + x.id, title: x.title, sub: x.neighbourhood + ', ' + x.city + ' · ' + h.money(x.rent_amount).replace('.00', '') + ' / month' }))).replace(/</g, '\\u003c') %>;
          var slides = [].slice.call(document.querySelectorAll('.hero-slide')), dots = [].slice.call(document.querySelectorAll('#hero-dots button'));
          var cap = document.getElementById('hero-caption'), i = 0, timer = null;
          function load(k) { var s = slides[k]; if (s.dataset.bg) { s.style.backgroundImage = "url('" + s.dataset.bg + "')"; delete s.dataset.bg; } }
          function show(k) {
            i = (k + slides.length) % slides.length; load(i);
            slides.forEach(function (s, j) { s.classList.toggle('on', j === i); });
            dots.forEach(function (d, j) { d.classList.toggle('on', j === i); });
            cap.href = apts[i].href; cap.querySelector('b').textContent = apts[i].title; cap.querySelector('span').textContent = apts[i].sub;
            load((i + 1) % slides.length); // have the next photo ready
          }
          function start() { stop(); if (!matchMedia('(prefers-reduced-motion: reduce)').matches) timer = setInterval(function () { if (!document.hidden) show(i + 1); }, 6000); }
          function stop() { clearInterval(timer); }
          dots.forEach(function (d, j) { d.addEventListener('click', function () { show(j); start(); }); });
          cap.addEventListener('mouseenter', stop); cap.addEventListener('mouseleave', start);
          cap.addEventListener('focus', stop); cap.addEventListener('blur', start);
          load(1); start();
        });
      </script>
    <% } %>
  <% } %>
  <div class="wrap">
    <div class="hero-inner">
      <span class="pill"><span class="dot"></span>Homes across Zambia</span>
      <h1 class="hero-title">Find your next home in <span class="accent">Zambia</span></h1>
      <p class="hero-sub">Apartments and houses listed directly by landlords in <%= cities.length > 1 ? cities.slice(0, -1).join(', ') + ' and ' + cities[cities.length - 1] : 'Zambia' %>. Move in, report problems and pay rent with Mobile Money, all in one place.</p>
      <div class="hero-cta">
        <a class="btn lg" href="#listings">Browse apartments</a>
        <a class="btn lg glass" href="<%= ctaHref %>"><%= ctaText %></a>
      </div>
    </div>
  </div>
</section>

<div class="wrap">
  <!-- Filters -->
  <form class="card filters hero-search" method="get" action="/#listings" role="search">
    <div>
      <label for="city">City</label>
      <select id="city" name="city">
        <option value="">All cities</option>
        <% cities.forEach(c => { %><option <%= filters.city === c ? 'selected' : '' %>><%= c %></option><% }) %>
      </select>
    </div>
    <div>
      <label for="bedrooms">Bedrooms</label>
      <select id="bedrooms" name="bedrooms">
        <option value="">Any</option>
        <% [1,2,3,4].forEach(n => { %><option value="<%= n %>" <%= String(filters.bedrooms) === String(n) ? 'selected' : '' %>><%= n %>+</option><% }) %>
      </select>
    </div>
    <div>
      <label for="max_rent">Max rent / month</label>
      <select id="max_rent" name="max_rent">
        <option value="">Any</option>
        <% [2500, 5000, 8000, 12000, 20000].forEach(n => { %><option value="<%= n %>" <%= String(filters.max_rent) === String(n) ? 'selected' : '' %>><%= h.money(n).replace('.00','') %></option><% }) %>
      </select>
    </div>
    <div style="display:flex;gap:8px">
      <button class="btn navy"><svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.8-3.8"/></svg>Search</button>
      <% if (filtered) { %><a class="btn secondary" href="/#listings">Clear</a><% } %>
    </div>
  </form>

  <% if (!filtered) { %>
    <!-- What you'll find -->
    <% if (popularServices.length) { %>
      <section class="section">
        <div class="section-head">
          <span class="eyebrow">What you'll find</span>
          <h2>Everything you need to settle in</h2>
          <p class="muted">Each listing shows exactly which services come with the apartment.</p>
        </div>
        <div class="feature-grid">
          <% popularServices.forEach(s => { %>
            <div class="card feature"><span class="ico"><%- svc.serviceIcon(s) %></span><b><%= s.label %></b></div>
          <% }) %>
        </div>
      </section>
    <% } %>

    <!-- At a glance -->
    <section class="section">
      <div class="section-head"><span class="eyebrow">At a glance</span><h2>Room for you in Zambia</h2></div>
      <div class="glance">
        <div class="card"><div class="num green"><%= counts.total %></div><div class="lbl">apartments available now</div></div>
        <div class="card"><div class="num"><%= counts.cities %></div><div class="lbl">cities</div></div>
        <div class="card"><div class="num"><%= counts.landlords %></div><div class="lbl">landlords listing</div></div>
        <div class="card"><div class="num"><%= counts.from_rent ? h.money(counts.from_rent).replace('.00','') : '—' %></div><div class="lbl">rent from, per month</div></div>
      </div>
    </section>
  <% } %>

  <!-- Listings -->
  <section class="section" id="listings">
    <div class="section-head">
      <span class="eyebrow"><%= filtered ? 'Search results' : 'All apartments' %></span>
      <h2><%= apartments.length %> <%= apartments.length === 1 ? 'apartment' : 'apartments' %><%= filtered ? ' match your search' : ' across Zambia' %></h2>
      <div class="vacancy-summary">
        <span class="badge green"><%= vacantCount %> vacant</span>
        <span class="badge gold"><%= occupiedCount %> occupied</span>
      </div>
    </div>
    <% if (!apartments.length) { %>
      <div class="card empty">No apartments match your search. Try removing a filter.</div>
    <% } else { %>
      <div class="listing-grid">
        <% apartments.forEach(apt => { %>
          <article class="card listing <%= apt.status === 'occupied' ? 'is-occupied' : '' %>">
            <% if (apt.photos.length > 1) { %>
              <%- include('partials/apt-slider', { apt, href: '/apartments/' + apt.id }) %>
            <% } else { %>
              <%- include('partials/apt-image', { apt, showPrice: true, showVacancy: true }) %>
            <% } %>
            <div class="body">
              <a class="title stretched" href="/apartments/<%= apt.id %>"><%= apt.title %></a>
              <div class="muted small">📍 <%= apt.neighbourhood %>, <%= apt.city %></div>
              <div class="facts" style="margin-top:4px">
                <span>🛏 <%= apt.bedrooms %> bed</span>
                <span>🛁 <%= apt.bathrooms %> bath</span>
              </div>
              <% if (apt.status === 'occupied') { %><div class="occupied-note">🔒 Occupied, not available right now</div><% } %>
            </div>
          </article>
        <% }) %>
      </div>
      <script>
        // Photo slideshows on the listing cards: swipe on phones, arrows on computers, dots show position.
        // Photos after the first load only when they are about to be shown.
        document.querySelectorAll('[data-slider]').forEach(function (sl) {
          var track = sl.querySelector('.slides'), imgs = Array.prototype.slice.call(track.children);
          var dots = Array.prototype.slice.call(sl.querySelectorAll('.sl-dots i')), counter = sl.querySelector('.sl-count');
          var n = imgs.length, i = 0, target = null;
          function load(k) { var im = imgs[(k + n) % n]; if (im && im.dataset.src) { im.src = im.dataset.src; im.removeAttribute('data-src'); } }
          function mark(k) {
            dots.forEach(function (d, j) { d.classList.toggle('on', j === k); });
            if (counter) counter.textContent = (k + 1) + ' / ' + n;
          }
          // Arrow clicks set the target straight away, so quick repeated clicks each move one photo.
          function go(k) {
            k = (k + n) % n; i = k; target = k;
            load(k); load(k + 1); mark(k);
            track.scrollTo({ left: k * track.clientWidth, behavior: 'smooth' });
            // Safety net: if the animation is cut short (busy phone, hidden tab), jump to the photo.
            setTimeout(function () {
              if (target === k && Math.abs(track.scrollLeft - k * track.clientWidth) > 2) {
                track.scrollTo({ left: k * track.clientWidth, behavior: 'instant' });
                target = null;
              }
            }, 700);
          }
          track.addEventListener('scroll', function () {
            if (target !== null) {
              if (Math.abs(track.scrollLeft - target * track.clientWidth) < 2) target = null;
              return; // still animating to the arrow's target
            }
            var k = Math.round(track.scrollLeft / track.clientWidth); // swiped by hand
            if (k !== i) { i = k; load(k); load(k + 1); mark(k); }
          }, { passive: true });
          track.addEventListener('touchstart', function () { target = null; }, { passive: true });
          sl.querySelector('.sl-prev').addEventListener('click', function (e) { e.preventDefault(); go(i - 1); });
          sl.querySelector('.sl-next').addEventListener('click', function (e) { e.preventDefault(); go(i + 1); });
          track.addEventListener('click', function () { location.href = sl.dataset.href; });
          ['pointerenter', 'touchstart', 'focusin'].forEach(function (ev) { sl.addEventListener(ev, function () { load(1); }, { once: true, passive: true }); });
          window.addEventListener('resize', function () { track.scrollLeft = i * track.clientWidth; });
        });
      </script>
    <% } %>
  </section>

  <% if (!filtered) { %>
    <!-- How it works -->
    <section class="section">
      <div class="section-head"><span class="eyebrow">How it works</span><h2>Move in, in three steps</h2></div>
      <div class="steps">
        <div class="card step"><div class="step-num">1</div><h3>Find a place</h3><p>Browse apartments, look through the photos and see exactly which services each one offers.</p></div>
        <div class="card step"><div class="step-num">2</div><h3>Apply or use an invite code</h3><p>Apply in a minute, or enter the code your landlord gave you, and you're connected.</p></div>
        <div class="card step"><div class="step-num">3</div><h3>Manage it all online</h3><p>Pay rent with MTN, Airtel or Zamtel Mobile Money, and report problems straight to your landlord.</p></div>
      </div>
    </section>

    <section class="card cta-panel">
      <span class="eyebrow">For landlords</span>
      <h2>Have an apartment to rent?</h2>
      <p class="muted" style="max-width:520px;margin:0 auto 20px">List it with photos and services, approve tenants, track rent and handle problems from one dashboard.</p>
      <a class="btn lg" href="<%= ctaHref %>"><%= ctaText %></a>
    </section>
  <% } %>
</div>

<%- include('partials/footer') %>
