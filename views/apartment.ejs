<%- include('partials/header') %>
<% const a = apartment; const cover = photos[0]; const photoGroups = h.rooms.groupByRoom(photos).filter(g => g.photos.length); const ordered = photoGroups.flatMap(g => g.photos.map(p => ({ ...p, roomLabel: g.room.key === 'other' ? 'More photos' : g.room.label })));  const extras = (a.amenities || '').split(',').map(s => s.trim()).filter(Boolean); %>

<!-- Hero with cover photo -->
<section class="apt-hero">
  <div class="bgimg">
    <% if (cover) { %><img src="<%= h.photoSrc(cover.filename) %>" srcset="<%= h.photoSrcset(cover.filename) %>" sizes="100vw" fetchpriority="high" alt="<%= cover.caption || a.title %>">
    <% } else if (a.image_url) { %><img src="<%= a.image_url %>" alt="<%= a.title %>">
    <% } else { %><%- include('partials/apt-illustration', { apt: a, idSuffix: 'hero' }) %><% } %>
  </div>
  <div class="wrap" style="width:100%">
    <a class="back" href="/#listings">← All apartments</a>
    <div style="margin-top:14px"><span class="pill"><span class="dot"></span><%= a.neighbourhood %>, <%= a.city %></span></div>
    <h1><%= a.title %></h1>
    <div class="facts-row">
      <span>🛏 <%= a.bedrooms %> bedroom<%= a.bedrooms === 1 ? '' : 's' %></span>
      <span>🛁 <%= a.bathrooms %> bathroom<%= a.bathrooms === 1 ? '' : 's' %></span>
      <span><%= a.status === 'available' ? '✅ Vacant' : '🔒 Occupied' %></span>
      <% if (photos.length) { %><span>📷 <%= photos.length %> photo<%= photos.length === 1 ? '' : 's' %></span><% } %>
    </div>
  </div>
</section>

<div class="wrap">
  <div class="apt-layout">
    <div>
      <!-- Services -->
      <section class="section" style="padding-top:8px">
        <span class="eyebrow">What this apartment offers</span>
        <h2 class="big">Services &amp; amenities</h2>
        <% if (serviceList.length) { %>
          <div class="feature-grid" style="margin-top:16px">
            <% serviceList.forEach(s => { %>
              <div class="card feature"><span class="ico"><%- svc.serviceIcon(s) %></span><b><%= s.label %></b></div>
            <% }) %>
          </div>
        <% } else if (!extras.length) { %>
          <p class="muted">The landlord hasn't listed the services yet.</p>
        <% } %>
        <% if (extras.length) { %>
          <div class="chip-row" style="justify-content:flex-start;margin-top:14px">
            <% extras.forEach(e => { %><span class="chip"><%= e %></span><% }) %>
          </div>
        <% } %>
      </section>

      <!-- Gallery -->
      <section class="section">
        <span class="eyebrow">The apartment</span>
        <h2 class="big">Take a look around</h2>
        <% if (photos.length) { %>
          <div class="gallery-groups">
          <% let shotIndex = 0; photoGroups.forEach(g => { const label = g.room.key === 'other' ? 'More photos' : g.room.label; %>
            <div class="gallery-group" style="--n: <%= Math.min(g.photos.length, 3) %>">
              <h3><%= label %> <span class="muted small"><%= g.photos.length %> photo<%= g.photos.length === 1 ? '' : 's' %></span></h3>
              <div class="gallery">
                <% g.photos.forEach((p, k) => { const i = shotIndex++; %>
                  <button type="button" class="shot <%= k === 0 && g.photos.length > 2 ? 'wide' : '' %>" data-index="<%= i %>" aria-label="View photo: <%= p.caption || label %>">
                    <img src="<%= h.photoSrc(p.filename, 'thumb') %>" alt="<%= p.caption || label %>" loading="lazy">
                    <% if (p.caption) { %><span class="cap"><%= p.caption %></span><% } %>
                  </button>
                <% }) %>
              </div>
            </div>
          <% }) %>
          </div>
        <% } else { %>
          <div class="card empty" style="margin-top:16px">No photos yet. <% if (applyState === 'owner') { %><a href="/landlord/apartments/<%= a.id %>?tab=photos">Add photos</a><% } else { %>Check back soon.<% } %></div>
        <% } %>
      </section>

      <!-- Location & directions -->
      <%
        // Visitors see the neighbourhood only; the street address stays private to the landlord.
        const mapOpts = { includeAddress: applyState === 'owner' };
        const mapPlace = h.mapQuery(a, mapOpts);
      %>
      <section class="section" id="location">
        <span class="eyebrow">Location</span>
        <h2 class="big">Where it is</h2>
        <div class="card apt-map" style="margin-top:16px">
          <div class="map-stage">
            <iframe id="apt-map" src="<%= h.mapEmbedUrl(a, mapOpts) %>" title="Map of <%= a.neighbourhood %>, <%= a.city %>" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
            <div class="map-place">
              <% if (cover) { %><img src="<%= h.photoSrc(cover.filename, 'thumb') %>" alt="" loading="lazy"><% } %>
              <div>
                <b><%= a.title %></b>
                <span class="tiny">📍 <%= a.neighbourhood %>, <%= a.city %></span>
                <span class="map-price"><%= h.money(a.rent_amount).replace('.00', '') %> <small>/ month</small></span>
              </div>
            </div>
          </div>
          <div class="map-actions">
            <button type="button" class="btn" id="dir-btn" data-place="<%= mapPlace %>">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2 4 20l8-4 8 4z"/></svg>
              Directions from where I am
            </button>
            <a class="btn secondary" id="dir-open" href="https://www.google.com/maps/dir/?api=1&destination=<%= encodeURIComponent(mapPlace) %>" target="_blank" rel="noopener">Open in Google Maps</a>
            <p class="tiny" id="dir-note" role="status"><%= applyState === 'owner' ? 'You see the exact address; visitors see the neighbourhood only.' : 'The map shows the neighbourhood. The landlord shares the exact address when you arrange a visit.' %></p>
          </div>
        </div>
        <script>
          // Directions: ask the browser where the visitor is, then draw the route to the apartment on the map.
          (function () {
            var btn = document.getElementById('dir-btn'), note = document.getElementById('dir-note');
            var map = document.getElementById('apt-map'), open = document.getElementById('dir-open');
            var place = encodeURIComponent(btn.dataset.place), label = btn.lastChild;
            btn.addEventListener('click', function () {
              if (!navigator.geolocation) { note.textContent = 'This browser cannot share your location. Use "Open in Google Maps" instead.'; return; }
              btn.disabled = true; label.textContent = ' Finding where you are…';
              navigator.geolocation.getCurrentPosition(function (pos) {
                var from = pos.coords.latitude.toFixed(6) + ',' + pos.coords.longitude.toFixed(6);
                map.src = 'https://maps.google.com/maps?saddr=' + from + '&daddr=' + place + '&output=embed';
                open.href = 'https://www.google.com/maps/dir/?api=1&origin=' + from + '&destination=' + place;
                open.textContent = 'Start navigation in Google Maps';
                note.textContent = 'Showing the route from where you are now. Distance and travel time are on the map.';
                btn.disabled = false; label.textContent = ' Update my location';
              }, function (err) {
                note.textContent = err.code === 1
                  ? 'Location is blocked for this site. Allow it in your browser, or use "Open in Google Maps".'
                  : 'Could not find where you are. Check that location is on, or use "Open in Google Maps".';
                btn.disabled = false; label.textContent = ' Directions from where I am';
              }, { enableHighAccuracy: true, timeout: 12000, maximumAge: 60000 });
            });
          })();
        </script>
      </section>

      <!-- About -->
      <section class="section">
        <span class="eyebrow">About</span>
        <h2 class="big">About this apartment</h2>
        <div class="card pad" style="margin-top:12px">
          <p style="white-space:pre-line;margin:0"><%= a.description || 'No description yet.' %></p>
          <p class="tiny" style="margin:14px 0 0">Listed by <b><%= a.landlord_name %></b></p>
        </div>
      </section>
    </div>

    <!-- Apply card -->
    <aside>
     <div class="apt-aside">
      <div class="card pad">
        <div class="muted small">Monthly rent</div>
        <div class="price-big"><%= h.money(a.rent_amount) %></div>
        <p class="tiny">Paid monthly with Mobile Money (MTN MoMo, Airtel Money, Zamtel Kwacha)</p>
        <hr style="border:0;border-top:1px solid var(--line);margin:16px 0">

        <% if (applyState === 'can_apply') { %>
          <form method="post" action="/apartments/<%= a.id %>/apply">
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <%- include('partials/household-fields', { occupants: '', note: '' }) %>
            <div class="field">
              <label for="message">Message to the landlord</label>
              <textarea id="message" name="message" placeholder="Introduce yourself, and say when you'd like to move in…"></textarea>
            </div>
            <button class="btn block lg">Apply for this apartment</button>
          </form>
          <p class="tiny" style="margin-top:10px">Have an invite code from the landlord? <a href="/tenant">Enter it here</a>.</p>
        <% } else if (applyState === 'guest') { %>
          <a class="btn block lg" href="/register?role=tenant&next=/apartments/<%= a.id %>">Sign up to apply</a>
          <p class="small muted" style="margin-top:10px;text-align:center">Already have an account? <a href="/login?next=/apartments/<%= a.id %>">Log in</a></p>
        <% } else if (applyState === 'applied') { %>
          <div class="callout">You've applied for this apartment. You'll see the landlord's decision on <a href="/tenant">My home</a>.</div>
        <% } else if (applyState === 'has_home') { %>
          <div class="callout">You're already connected to an apartment. <a href="/tenant">Go to My home</a>.</div>
        <% } else if (applyState === 'owner') { %>
          <a class="btn block" href="/landlord/apartments/<%= a.id %>?tab=photos">Manage photos &amp; services</a>
          <a class="btn block secondary" style="margin-top:8px" href="/landlord/apartments/<%= a.id %>">Manage this apartment</a>
        <% } else if (applyState === 'taken') { %>
          <div class="callout">This apartment is currently occupied.</div>
        <% } else { %>
          <p class="small muted">Landlord accounts can't apply for apartments.</p>
        <% } %>
      </div>

      <%
        // Contact the landlord directly (for vacant apartments, if the landlord allows it).
        const waNumber = a.landlord_whatsapp || a.landlord_phone;
        const waText = `Hello ${a.landlord_name.split(' ')[0]}, I saw your apartment "${a.title}" in ${a.neighbourhood}, ${a.city} on Tour Masters Apartments (${h.money(a.rent_amount)}/month). Is it still available?`;
        const showContact = a.status === 'available' && (a.landlord_show_contact || applyState === 'owner') && (h.telHref(a.landlord_phone) || h.whatsappHref(waNumber, waText));
      %>
      <% if (showContact) { %>
        <div class="card pad contact-card" id="contact">
          <h3 style="margin:0 0 4px">Contact the landlord</h3>
          <p class="small muted" style="margin:0 0 14px">Having trouble applying online? Call or message <%= a.landlord_name.split(' ')[0] %> directly.</p>
          <div class="person" style="margin-bottom:14px">
            <div class="avatar"><%= h.initials(a.landlord_name) %></div>
            <div><b><%= a.landlord_name %></b><div class="tiny">Landlord<%= a.landlord_phone ? ' · ' + a.landlord_phone : '' %></div></div>
          </div>
          <div class="contact-buttons">
            <% if (h.telHref(a.landlord_phone)) { %>
              <a class="btn secondary block" href="<%= h.telHref(a.landlord_phone) %>">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></svg>
                Call
              </a>
            <% } %>
            <% if (h.whatsappHref(waNumber, waText)) { %>
              <a class="btn block whatsapp" href="<%= h.whatsappHref(waNumber, waText) %>" target="_blank" rel="noopener">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.8-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.9 11.9 0 0 0 4.6 4c1.7.7 2.4.8 3.2.7a2.8 2.8 0 0 0 1.8-1.3 2.3 2.3 0 0 0 .2-1.3c-.1-.1-.3-.2-.5-.3z"/></svg>
                WhatsApp
              </a>
            <% } %>
          </div>
          <% if (a.landlord_email) { %>
            <p class="tiny" style="margin:12px 0 0">Or email <a href="mailto:<%= a.landlord_email %>?subject=<%= encodeURIComponent('Enquiry about ' + a.title) %>"><%= a.landlord_email %></a></p>
          <% } %>
          <% if (applyState === 'owner' && !a.landlord_show_contact) { %>
            <p class="tiny" style="margin:10px 0 0">Only you can see this: your contact details are hidden from visitors. <a href="/account">Change this</a>.</p>
          <% } %>
        </div>
      <% } %>
     </div>
    </aside>
  </div>
</div>

<% if (photos.length) { %>
<dialog class="lightbox" id="lightbox" aria-label="Photo viewer">
  <button class="lb-close" type="button" aria-label="Close">✕</button>
  <button class="lb-btn lb-prev" type="button" aria-label="Previous photo">‹</button>
  <figure><img alt=""><figcaption></figcaption></figure>
  <button class="lb-btn lb-next" type="button" aria-label="Next photo">›</button>
</dialog>
<script>
  (function () {
    var photos = <%- JSON.stringify(ordered.map(p => ({ src: h.photoSrc(p.filename), thumb: h.photoSrc(p.filename, 'thumb'), caption: p.caption && p.caption.toLowerCase() !== p.roomLabel.toLowerCase() ? p.roomLabel + ' · ' + p.caption : p.roomLabel }))).replace(/</g, '\\u003c') %>;
    var dlg = document.getElementById('lightbox'), img = dlg.querySelector('img'), cap = dlg.querySelector('figcaption'), i = 0;
    function show(n) {
      i = (n + photos.length) % photos.length;
      var p = photos[i], want = i;
      // Show the small photo (already loaded on the page) at once, then swap in the full-size one when ready.
      img.src = p.thumb; img.alt = p.caption;
      if (p.src !== p.thumb) { var full = new Image(); full.onload = function () { if (i === want) img.src = p.src; }; full.src = p.src; }
      cap.textContent = p.caption + (photos.length > 1 ? '  (' + (i + 1) + ' / ' + photos.length + ')' : '');
    }
    document.querySelectorAll('.gallery .shot').forEach(function (b) { b.addEventListener('click', function () { show(+b.dataset.index); dlg.showModal(); }); });
    dlg.querySelector('.lb-prev').onclick = function () { show(i - 1); };
    dlg.querySelector('.lb-next').onclick = function () { show(i + 1); };
    dlg.querySelector('.lb-close').onclick = function () { dlg.close(); };
    dlg.addEventListener('click', function (e) { if (e.target === dlg) dlg.close(); });
    document.addEventListener('keydown', function (e) { if (!dlg.open) return; if (e.key === 'ArrowLeft') show(i - 1); if (e.key === 'ArrowRight') show(i + 1); });
    if (photos.length < 2) { dlg.querySelector('.lb-prev').hidden = true; dlg.querySelector('.lb-next').hidden = true; }
  })();
</script>
<% } %>

<%- include('partials/footer') %>
