# Copy this file to .env and fill in your values. Never commit .env.

# Flutterwave SECRET key from https://app.flutterwave.com/dashboard/settings/apis
# Use the test key (FLWSECK_TEST-...) while developing. Leave empty to use the built-in simulator.
FLW_SECRET_KEY=

# Webhook secret hash: any long random text. Put the same value in the Flutterwave dashboard
# under Settings > Webhooks. Only needed once the site is online.
FLW_SECRET_HASH=

# Public address of the site, used for Flutterwave's return link. Leave empty when running locally.
PUBLIC_URL=

# Long random string that signs login cookies, so logins survive restarts.
SESSION_SECRET=

# Email. Leave SMTP_HOST empty to save emails to data/outbox instead of sending them.
# Most email services give you these: e.g. Gmail (smtp.gmail.com, port 587, an "app password"),
# Brevo, Mailgun, SendGrid, Zoho, or your web host's mail server.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Tour Masters Apartments <no-reply@your-domain.com>

PORT=3000
